# [TEMPLATE]
# App URL — used for Open Graph / social sharing meta tags.
# Set to your production domain (e.g., https://onramp.dev) in production.
# Defaults to http://localhost:5173 in development.
VITE_APP_URL=http://localhost:5173
# Production: VITE_APP_URL=https://developer-onboard.vercel.app

# API URL (optional, defaults to http://localhost:8000/api/v1)
VITE_API_URL=http://localhost:8000/api/v1
# Production (Vercel): VITE_API_URL=/api/v1 — vercel.json proxies /api to Render so auth cookies stay same-site

# Neon Auth URL (optional, defaults to window.origin + /api/v1/auth)
# VITE_NEON_AUTH_URL=

# Waitlist service base URL (optional, defaults to http://localhost:3008)
# VITE_WAITLIST_URL=http://localhost:3008

# Notification bell polling interval in milliseconds (optional, defaults to 120000 = 2 min)
# VITE_NOTIFICATION_POLL_INTERVAL=120000
