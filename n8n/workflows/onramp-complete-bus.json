    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Build an escalation message for ramp.stuck / pr.merged.\nconst item = $input.first().json;\nconst urgent = (item.severity === 'high' || item.severity === 'critical');\nlet text = (urgent ? ':rotating_light: *URGENT* ' : ':warning: *Stuck-dev alert* ') + '`' + item.event + '`\\n';\ntext += '*' + item.title + '*';\nif (item.team_id) text += '\\nTeam: `' + item.team_id + '`';\ntext += '\\nSeverity: *' + (item.severity || 'medium') + '*\\nOpen Onramp \u2192 Ramp view to intervene.';\nreturn [{ json: { channel: '#onboarding-alerts', text, source_event: item.event } }];"
      },
      "id": "21bea10a-8b9b-4451-b7af-c65835a6cd71",
