      },
      "id": "ced6767c-2ff8-41bd-b798-8311980bb725",
      "name": "Onramp Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "webhookId": "d332d6c0-88cd-41e0-b69b-889cd3ee65d3"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Normalize the Onramp outbound envelope into a flat routing item.\n// Incoming shape: { event, source, timestamp, data: { task?, plan?, milestone?, pulse?, actor? } }\nconst body = $input.first().json;\nconst event = body.event || 'unknown';\nconst data = body.data || {};\nconst task = data.task || {};\nconst plan = data.plan || {};\nconst milestone = data.milestone || {};\nconst pulse = data.pulse || {};\nconst team_id = task.team_id || plan.team_id || data.team_id || '';\nconst title = task.title || plan.title || milestone.title || event;\nconst actor = data.actor || data.triggered_by || '';\nlet severity = 'info';\nif (event === 'ramp.stuck') severity = data.severity || 'medium';\nif (event === 'task.needs_changes') severity = 'medium';\nreturn [{\n  json: {\n    event, team_id, title, actor, severity,\n    task, plan, milestone, pulse,\n    raw: body,\n    received_at: new Date().toISOString(),\n  }\n}];"
      },
      "id": "443f1538-470e-40bb-af71-db200a0d6cbf",
      "name": "Normalize Onramp Event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "4100ff30-c863-42f1-80d8-c38e23f9da7b",
              "leftValue": "={{ $json.event }}",
              "rightValue": "onboarding",
              "operator": {
                "type": "string",
                "operation": "contains"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "94f684df-375e-437b-a3d9-b2e3e5470640",
      "name": "Is Onboarding Event?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Build a Telegram-ready message from the normalized item.\nconst item = $input.first().json;\nconst lines = [\n  '\ud83d\udce6 *Onramp update*',\n  '*Event:* `' + item.event + '`',\n  '*Title:* ' + item.title,\n];\nif (item.team_id) lines.push('*Team:* `' + item.team_id + '`');\nif (item.actor) lines.push('*By:* ' + item.actor);\nif (item.task && item.task.task_id) lines.push('*Task:* `' + item.task.task_id + '`');\nif (item.plan && item.plan.id) lines.push('*Plan:* `' + item.plan.id + '`');\nlines.push('', '_Sent from Onramp via n8n_');\nreturn [{ json: { chat_id: '@your_channel', text: lines.join('\\n'), source_event: item.event } }];\n// NOTE: replace @your_channel with your Telegram channel, or wire chat_id dynamically."
      },
      "id": "99490d46-5c78-4876-ba57-1e6a1aea5218",
      "name": "Format Telegram Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        180
      ]
    },
    {
      "parameters": {
        "chatId": "={{ $json.chat_id }}",
        "text": "={{ $json.text }}",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "0776a355-be13-4cc5-973b-d559b1d6cc4f",
      "name": "Send Telegram",
