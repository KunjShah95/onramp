    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Build a Slack-ready message from the normalized item.\nconst item = $input.first().json;\nlet icon = ':bell:';\nif (item.event.indexOf('completed') !== -1) icon = ':white_check_mark:';\nelse if (item.event.indexOf('approved') !== -1) icon = ':heavy_check_mark:';\nelse if (item.event.indexOf('merged') !== -1) icon = ':twisted_rightwards_arrows:';\nlet text = icon + ' *Onramp* `' + item.event + '` \u2014 *' + item.title + '*';\nif (item.team_id) text += ' (team `' + item.team_id + '`)';\nif (item.actor) text += ' \u2014 by ' + item.actor;\nreturn [{ json: { channel: '#onboarding', text, source_event: item.event } }];"
      },
      "id": "cccd6598-8d5e-43e6-8e8f-5087bd1ea79f",
      "name": "Format Slack Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
