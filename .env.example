# ── Docker Compose Environment ───────────────────────────────────────────────
# Copy this file to .env and customize:
#   cp .env.example .env

# ── Database ─────────────────────────────────────────────────────────────────
DB_PASSWORD=postgres_password

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=redis_password

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-random-secret-min-32-chars
# HMAC-SHA256 pepper for API key hashing. Generate: python -c "import secrets; print(secrets.token_hex(32))"
API_KEY_HMAC_SECRET=change-me-to-a-random-secret-min-32-chars
# Keep "true" until pre-rotation keys (hashed with the dev default) are regenerated.
API_KEY_ALLOW_LEGACY_PEPPER=true
# Swagger docs and the /api/v1/seed/* demo router are off when ENV=production;
# set to true to opt back in for staging.
ENABLE_API_DOCS=false
ENABLE_SEED_ROUTER=false
# Fernet key for encrypting email/name at rest. Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PII_ENCRYPTION_KEY=
# Fernet key for encrypting stored GitHub tokens (NOT a plain string — use the
# Fernet.generate_key() output, otherwise production boot validation fails).
GITHUB_TOKEN_ENCRYPTION_KEY=
# Without a token, GitHub API rate limit is 60 requests/hr.
# With a token, it is 5,000 requests/hr.
# Create a classic PAT at https://github.com/settings/tokens
GITHUB_TOKEN=
# Honor X-Forwarded-For only behind a trusted proxy (nginx). Keep false for local dev.
TRUST_PROXY=false

# ── GitHub OAuth App (user login / account linking) ───────────────────────────
# Register at https://github.com/settings/developers → New OAuth App.
#   Authorization callback: {BACKEND_URL}/api/v1/auth/oauth/github/callback
# Scopes requested: read:user user:email
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Shared secret for GitHub webhook HMAC-SHA256 verification.
GITHUB_WEBHOOK_SECRET=
# Public URL of this API — the OAuth callback must match exactly.
BACKEND_URL=
# Public URL of the frontend — where OAuth callbacks redirect the browser.
FRONTEND_URL=

# ── Razorpay (optional — billing features, INR) ──────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_STARTUP=
RAZORPAY_PLAN_PROFESSIONAL=
RAZORPAY_PLAN_USAGE_BASED=

# ── SENDGRID (optional — transactional email) ─────────────────────────────────
SENDGRID_API_KEY=

# ── LLM Providers (set at least one or many features won't work) ──────────────
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=
MISTRAL_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
HUGGINGFACE_API_KEY=

# ── Frontend API URL (optional, defaults to /api/v1 for same-origin via Nginx proxy) ─
# In Docker, the frontend Nginx proxies /api/* to the backend, so /api/v1 works.
# For local dev (npm run dev), set to http://localhost:8000/api/v1.
VITE_API_URL=/api/v1

# ── Slack Integration ─────────────────────────────────────────────────────────
# Incoming webhook URL for sending channel messages (used by the standup bot
# and digest broadcasts). Create one at:
#   https://api.slack.com/apps -> Your App -> Incoming Webhooks
SLACK_WEBHOOK_URL=

# Bot token for proactive DMs (chat.postMessage) and interactive components.
# Needed for: standup reminders, acknowledgments, channel broadcasts.
# Create at:  https://api.slack.com/apps -> Your App -> OAuth & Permissions
# Scopes needed: chat:write, channels:read, groups:read
SLACK_BOT_TOKEN=

# Signing secret for verifying Slack request signatures on slash commands and
# interactive payloads. Found in your Slack app's Basic Information page.
SLACK_SIGNING_SECRET=

# Default channel for standup broadcasts and team digest posts.
SLACK_STANDUP_CHANNEL=#standups

# Time for daily standup reminders (24h UTC format). The Celery beat task
# will send proactive DMs at this time each day.
SLACK_STANDUP_TIME=10:00

# ── n8n → Telegram (Onboarding sessions) ───────────────────────────────────
# n8n webhook that receives Onramp onboarding events and forwards to Telegram.
# Create in n8n: Webhook trigger (POST) → Telegram Bot node.
# Set either or both; _ONBOARDING_ wins over the generic one.
N8N_WEBHOOK_URL=
N8N_ONBOARDING_WEBHOOK_URL=
# Optional HMAC-SHA256 signing so n8n can verify the payload came from Onramp.
N8N_HMAC_SECRET=
# Direct Telegram bot fallback (if you skip n8n and call Telegram Bot API directly).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Seed / Demo config ───────────────────────────────────────────────────────
# Determines which teams get the Slack team digest broadcast.
# Can be a single team ID or left empty to auto-detect.
SLACK_TEAM_ID=
