# ── Environment ──────────────────────────────────────────────────────────────
# "production" | "development". Controls auth bypass, DB SSL defaults, migrations.
# ENV is preferred; ENVIRONMENT is accepted as a fallback.
ENV=development

# ── Auth (JWT / Neon Auth / PostgreSQL) ──────────────────────────────────────
# JWT signing secret. Use a strong random value in production.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=dev-jwt-secret-change-in-production
# Set to "true" to skip auth checks (dev only - auto-creates a mock user on every request).
AUTH_DEV_BYPASS=false
# Neon Auth — managed Better Auth JWKS endpoint and issuer for RS256 JWT validation.
NEON_AUTH_JWKS_URL=
NEON_AUTH_ISSUER=
# ── Database ─────────────────────────────────────────────────────────────────
# Required in production. asyncpg driver. (postgresql:// is auto-rewritten.)
DATABASE_URL=postgresql+asyncpg://onramp:postgres_password@localhost:5432/onramp
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
# disable | allow | prefer | require | verify-ca | verify-full
# Defaults to require in production, prefer otherwise.
DB_SSL_MODE=disable
DB_ECHO=false
# Set to "memory" to use the in-memory storage backend (tests/local, no DB).
STORAGE_BACKEND=

# ── LLM providers (free first, paid fallback) ────────────────────────────────
# Set any subset. Order: OpenRouter > Gemini > Groq > NVIDIA > OpenAI > Anthropic.
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Embedding providers (pluggable, free first) ─────────────────────────────
# Set any subset. Order: Gemini > NVIDIA > Ollama > HuggingFace > OpenAI > Cohere > Voyage.
# OpenAI/Gemini/NVIDIA reuse their LLM API keys above.
# Embeddings have no output tokens; per-model USD+INR pricing lives in llm_costs.py.
EMBEDDINGS_PROVIDER=          # optional: force a provider (e.g. "gemini")
EMBEDDING_DIMENSIONS=1536     # pgvector column dims — must match the provider's model
EMBEDDINGS_MIN_SIMILARITY=0.0 # minimum cosine similarity to accept vector results
COHERE_API_KEY=
VOYAGE_API_KEY=
# Optional per-provider model overrides:
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# GEMINI_EMBEDDING_MODEL=text-embedding-004
# NVIDIA_EMBEDDING_MODEL=NV-Embed-QA
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# HF_EMBEDDING_MODEL=all-MiniLM-L6-v2
# COHERE_EMBEDDING_MODEL=embed-english-v3.0
# VOYAGE_EMBEDDING_MODEL=voyage-code-3

# ── Currency ─────────────────────────────────────────────────────────────────
USD_TO_INR=85.0               # used to derive INR pricing when no INR rate is set

# ── GitHub (repo cloning / issue analysis) ────────────────────────────────────
# Create a classic PAT at https://github.com/settings/tokens. No scopes needed for
# public repos. Without a token, GitHub API rate limit is 60 requests/hr.
# With a token, it's 5,000 requests/hr.
GITHUB_TOKEN=

# ── HTTP / CORS / rate limiting ──────────────────────────────────────────────
# Comma-separated allowed origins for the frontend.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Honor X-Forwarded-For (only behind a trusted proxy/load balancer).
TRUST_PROXY=false
# ── Redis / Celery Task Queue ────────────────────────────────────────────────
# REQUIRED for Celery background tasks (agent analysis, notifications, indexing).
# Local dev: redis://localhost:6379/0
# Production: Use managed Redis (Render, AWS ElastiCache, Upstash, etc.)
# Format: redis://[user:password@]host:port/db
REDIS_URL=redis://localhost:6379/0

# ── Billing (Stripe) ─────────────────────────────────────────────────────────
# Optional. When unset, billing runs in metadata-only stub mode.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTUP=
STRIPE_PRICE_PROFESSIONAL=

# ── Email (SendGrid) ──────────────────────────────────────────────────────────
# Optional. When unset, email sending is a no-op.
SENDGRID_API_KEY=

# ── PII Encryption ─────────────────────────────────────────────────────────────
# Fernet key for encrypting email/name at rest. Required in production.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PII_ENCRYPTION_KEY=

# ── GitHub Token Encryption ────────────────────────────────────────────────────
# Fernet key for encrypting stored GitHub tokens. Required in production.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GITHUB_TOKEN_ENCRYPTION_KEY=

# ── API Key Security ───────────────────────────────────────────────────────────
# HMAC-SHA256 pepper for API key hashing. Required in production.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
API_KEY_HMAC_SECRET=

# ── Monitoring ─────────────────────────────────────────────────────────────────
# Sentry DSN for error tracking (optional). When unset, sentry-sdk is a no-op.
SENTRY_DSN=

# ── Observability (Prometheus + structured logging) ────────────────────────────
# Expose /metrics in Prometheus text format (default: true). Scraped by the
# prometheus service in docker-compose.prod.yml and graphed in Grafana.
ENABLE_METRICS=true
# Structured logging: "text" (dev) or "json" (production — one JSON object per
# line, parseable by Loki/Datadog/CloudWatch).
LOG_FORMAT=text
# Root log level: DEBUG | INFO | WARNING | ERROR (default INFO).
LOG_LEVEL=INFO

# ── Security headers ────────────────────────────────────────────────────────────
# Optional Content-Security-Policy header value. Off by default because the SPA
# ships inline styles/scripts — set it once the frontend emits a nonce/hash.
# Example: CSP_HEADER=default-src 'self'; script-src 'self'
CSP_HEADER=

# ── Ops / probes ───────────────────────────────────────────────────────────────
# /health  = liveness (process up)  — used by Docker/K8s restart probes.
# /ready   = readiness (DB + Redis reachable) — gates LB traffic; returns 503
#            when a dependency is down. No config needed.
# /metrics = Prometheus text exposition. No config needed.

